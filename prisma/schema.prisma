generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HeroSlide {
  id               Int      @id @default(autoincrement())
  tagline          String
  title            String
  description      String
  primaryBtnText   String
  primaryBtnHref   String
  secondaryBtnText String
  secondaryBtnHref String
  image            String
  imageAlt         String
  badgeText        String
  trustBadges      String   
  textColor        String?  @default("#1F2A37")
  textAlignment    String?  @default("Left")
  overlayEnabled   String?  @default("true")
  overlayOpacity   String?  @default("60")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteConfig {
  id               Int      @id @default(1)
  logoUrl          String
  logoAlt          String
  topBarText       String
  phone            String
  email            String
  whatsapp         String
  navLinks         String   // JSON string of array
  
  // Theme Configuration
  primaryColor     String   @default("#DE7B3D")
  bgColor          String   @default("#F7F5F2")
  textColor        String   @default("#1F2A37")
  headingFont      String   @default("inter")
  bodyFont         String   @default("inter")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PageSection {
  id        Int      @id @default(autoincrement())
  type      String   // e.g., "HERO", "BRAND_STORY", "SERVICES", "UNIFORMS", "WORK", "WHY_SILKY", "PROCESS", "TESTIMONIALS"
  order     Int      // To control display order
  data      String   // JSON string containing all text/images for this section
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPage {
  id              Int                  @id @default(autoincrement())
  slug            String               @unique
  title           String
  category        String
  heroImage       String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean              @default(true)
  sections        ProductPageSection[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model ProductPageSection {
  id            Int         @id @default(autoincrement())
  productPageId Int
  productPage   ProductPage @relation(fields: [productPageId], references: [id], onDelete: Cascade)
  type          String      // HERO, SPECS_MATRIX, CUSTOMIZATION, SECTORS, PROCESS, FAQ, QUOTE_BAND
  order         Int         @default(0)
  isActive      Boolean     @default(true)
  data          String      // JSON string
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
