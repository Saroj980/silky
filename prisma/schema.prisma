generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model HeroSlide {
  id               Int       @id @default(autoincrement())
  tagline          String?
  title            String
  description      String?   @db.Text
  primaryBtnText   String?
  primaryBtnHref   String?
  secondaryBtnText String?
  secondaryBtnHref String?
  image            String?   @db.Text
  imageAlt         String?
  badgeText        String?
  trustBadges      String?   @db.Text
  textColor        String?   @default("#1F2A37")
  textAlignment    String?   @default("Left")
  overlayEnabled   String?   @default("true")
  overlayOpacity   String?   @default("60")
  createdAt        DateTime? @map("created_at") @default(now())
  updatedAt        DateTime? @map("updated_at") @updatedAt

  @@map("hero_slides")
}

model SiteConfig {
  id               Int       @id @default(autoincrement())
  logoUrl          String?   @db.Text
  logoAlt          String?
  topBarText       String?   @db.Text
  phone            String?
  phoneSecondary   String?
  email            String?
  emailSecondary   String?
  whatsapp         String?
  address          String?   @db.Text
  navLinks         String?   @db.Text // JSON string of array
  
  primaryColor     String    @default("#DE7B3D")
  bgColor          String    @default("#F7F5F2")
  textColor        String    @default("#1F2A37")
  headingFont      String    @default("inter")
  bodyFont         String    @default("inter")

  createdAt        DateTime? @map("created_at") @default(now())
  updatedAt        DateTime? @map("updated_at") @updatedAt

  @@map("site_configs")
}

model PageSection {
  id        Int       @id @default(autoincrement())
  type      String    // e.g., "HERO", "BRAND_STORY", "SERVICES", "UNIFORMS", "WORK", "WHY_SILKY", "PROCESS", "TESTIMONIALS"
  order     Int       @default(0)
  data      String?   @db.LongText // JSON string
  isActive  Boolean   @default(true)
  createdAt DateTime? @map("created_at") @default(now())
  updatedAt DateTime? @map("updated_at") @updatedAt

  @@map("page_sections")
}

model ProductPage {
  id              Int                  @id @default(autoincrement())
  slug            String               @unique
  title           String
  category        String
  heroImage       String               @db.Text
  metaTitle       String?
  metaDescription String?              @db.Text
  isPublished     Boolean              @default(true)
  sections        ProductPageSection[]
  createdAt       DateTime?            @map("created_at") @default(now())
  updatedAt       DateTime?            @map("updated_at") @updatedAt

  @@map("product_pages")
}

model ProductPageSection {
  id            Int         @id @default(autoincrement())
  productPageId Int         @map("product_page_id")
  productPage   ProductPage @relation(fields: [productPageId], references: [id], onDelete: Cascade)
  type          String      // HERO, SPECS_MATRIX, CUSTOMIZATION, SECTORS, PROCESS, FAQ, QUOTE_BAND
  order         Int         @default(0)
  isActive      Boolean     @default(true)
  data          String      @db.LongText // JSON string
  createdAt     DateTime?   @map("created_at") @default(now())
  updatedAt     DateTime?   @map("updated_at") @updatedAt

  @@map("product_page_sections")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  username  String?
  role      String?   @default("Admin")
  password  String
  status    String?   @default("Active")
  createdAt DateTime? @map("created_at") @default(now())
  updatedAt DateTime? @map("updated_at") @updatedAt

  @@map("users")
}

model GeneralPage {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  subtitle        String?   @db.Text
  pageType        String    @default("General Page")
  status          String    @default("Published")
  isActive        Boolean   @default(true)
  featuredImage   String?   @db.Text
  content         String?   @db.LongText
  seoTitle        String?
  seoDescription  String?   @db.Text
  seoKeywords     String?   @db.Text
  ogImage         String?   @db.Text
  allowIndexing   Boolean   @default(true)
  author          String?   @default("Silky Team")
  createdAt       DateTime? @map("created_at") @default(now())
  updatedAt       DateTime? @map("updated_at") @updatedAt

  @@map("general_pages")
}
